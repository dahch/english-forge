# ============================================================
# EnglishForge — Environment Configuration
# ============================================================
# Copy this file to .env and fill in the required values.
# At minimum, you need JWT_SECRET_KEY and at least one LLM provider.
# ============================================================

# === REQUIRED ===
# Generate with: openssl rand -hex 32
JWT_SECRET_KEY=change-me-to-a-random-64-char-hex-string

# Optional: Fernet key for encrypting API keys in DB.
# If empty, derived from JWT_SECRET_KEY automatically.
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
SETTINGS_ENCRYPTION_KEY=

# === DATABASE ===
# SQLite is the default and only supported database — the file lives on the
# backend_data volume (/app/data) in Docker.
# DATABASE_URL is optional; if unset, SQLite is used automatically.

# === AUTH (optional) ===
# Optional PIN for extra protection when exposed outside LAN
APP_PIN=
# JWT token expiry in minutes (default: 1440 = 24h)
TOKEN_EXPIRE_MINUTES=1440

# === LLM PROVIDERS (at least one required) ===
# Configure via the Settings UI in the app — keys are stored encrypted in the
# database (provider_configs) and loaded from there at request time.
# NOTE: the *_API_KEY/… variables below are NOT read by the backend yet;
# env-based provider seeding is planned but not implemented (TBD).

# OpenAI
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4.1-mini

# Anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6

# DeepSeek
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat

# Fireworks
FIREWORKS_API_KEY=
FIREWORKS_BASE_URL=https://api.fireworks.ai/inference/v1
FIREWORKS_MODEL=accounts/fireworks/models/llama-v3p1-70b-instruct

# ClinePass (OpenAI-compatible endpoint)
CLINEPASS_API_KEY=
CLINEPASS_BASE_URL=
CLINEPASS_MODEL=

# Custom slot (any OpenAI-compatible endpoint)
CUSTOM_API_KEY=
CUSTOM_BASE_URL=
CUSTOM_MODEL=

# === TTS — Pocket TTS via personal-api (optional) ===
# The backend joins the "coolify" Docker network to reach personal-api
PERSONAL_API_URL=http://personal-api:8000
# Default voice — verify available voices against GET /v1/voices on Pocket TTS
TTS_DEFAULT_VOICE=alba
# Pocket TTS model id — sent on every /v1/speak call. Personal-api servers
# default to a Spanish model; english-forge pins the English one. Unknown
# ids are ignored by Pocket TTS (hot-swap safe, backward compatible).
TTS_MODEL=english_2026-04_24l
TTS_JOB_POLL_INTERVAL_MS=500
TTS_JOB_TIMEOUT_SECONDS=30

# === STT (optional) ===
# Modes: web_speech (default), whisper_wasm, whisper_server, personal_api
STT_MODE=web_speech
# Model for whisper_server mode (tiny, base, small, medium, large)
WHISPER_MODEL=small
# Language hint sent on every personal-api /v1/transcribe call. "en" unlocks
# real Moonshine word timestamps (used by the pronunciation fluency metrics).
STT_LANGUAGE=en
# The assessment transcribes recordings via personal-api (Moonshine) with an
# automatic faster-whisper in-process fallback (same WHISPER_MODEL).
# macOS local dev only: point phonemizer at the homebrew espeak-ng library —
# in Docker (Debian) espeak-ng is installed via apt and needs no env var.
# PHONEMIZER_ESPEAK_LIBRARY=/opt/homebrew/opt/espeak-ng/lib/libespeak-ng.1.dylib

# === CORS ===
CORS_ORIGINS=http://localhost:3590,http://127.0.0.1:3590
