# ============================================================
# EnglishForge — Environment Configuration
# ============================================================
# Copy this file to .env and fill in the required values.
# At minimum, you need JWT_SECRET_KEY and at least one LLM provider.
# ============================================================

# === REQUIRED ===
# Generate with: openssl rand -hex 32
# The backend REFUSES TO START if this is missing, shorter than 32 bytes, or
# still set to the placeholder below — a known signing key lets anyone forge a
# token for any user.
JWT_SECRET_KEY=change-me-to-a-random-64-char-hex-string

# Strongly recommended: dedicated Fernet key for encrypting provider API keys.
# If empty, a key is derived from JWT_SECRET_KEY — which means rotating the JWT
# secret makes every stored provider key unreadable.
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
SETTINGS_ENCRYPTION_KEY=

# Escape hatch for CI/local experiments ONLY. Downgrades the startup secret
# validation to a warning. Never enable it on an exposed instance.
ALLOW_INSECURE_DEFAULTS=false

# === DATABASE ===
# SQLite is the default and only supported database — the file lives on the
# backend_data volume (/app/data) in Docker.
# DATABASE_URL is optional; if unset, SQLite is used automatically.

# === AUTH ===
# Optional PIN for extra protection when exposed outside LAN
APP_PIN=
# Access-token lifetime. Sessions are kept alive transparently by a rotating
# refresh cookie, so this can stay short (default: 15 minutes).
ACCESS_TOKEN_EXPIRE_MINUTES=15
# How long a device stays signed in without re-entering the password.
REFRESH_TOKEN_EXPIRE_DAYS=30
# Maximum concurrent devices per user (oldest refresh tokens are revoked).
MAX_REFRESH_TOKENS_PER_USER=10
# Session cookies are HttpOnly. Set to true on any HTTPS deployment.
COOKIE_SECURE=false
# lax | strict | none
COOKIE_SAMESITE=lax
# Optional cookie domain (empty = host-only).
COOKIE_DOMAIN=
# Failed-login budget per email and per client IP (sliding window).
AUTH_RATE_LIMIT_ATTEMPTS=5
AUTH_RATE_LIMIT_WINDOW_SECONDS=900
# Registration budget per client IP (successes count too).
REGISTER_RATE_LIMIT_ATTEMPTS=5
REGISTER_RATE_LIMIT_WINDOW_SECONDS=3600
# The backend sits behind the Next.js rewrite proxy, so the browser IP arrives
# in X-Forwarded-For. Set to false only when the backend is exposed directly,
# otherwise a client could spoof its identity to dodge the limits.
TRUST_PROXY_HEADERS=true

# === LLM PROVIDERS ===
# Preferred: configure providers in the Settings UI — keys are stored encrypted
# in the database (provider_configs) and take precedence over the environment.
# The *_API_KEY variables below act as a SERVER-WIDE FALLBACK: they are used for
# any user who has no provider configured. Leave them empty on a shared
# instance, or every account would spend the owner's quota.

# OpenAI
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4.1-mini

# Anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6

# DeepSeek
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat

# Fireworks
FIREWORKS_API_KEY=
FIREWORKS_BASE_URL=https://api.fireworks.ai/inference/v1
FIREWORKS_MODEL=accounts/fireworks/models/llama-v3p1-70b-instruct

# ClinePass (OpenAI-compatible endpoint)
CLINEPASS_API_KEY=
CLINEPASS_BASE_URL=
CLINEPASS_MODEL=

# Custom slot (any OpenAI-compatible endpoint)
CUSTOM_API_KEY=
CUSTOM_BASE_URL=
CUSTOM_MODEL=

# === TTS — Pocket TTS via personal-api (optional) ===
# The backend joins the "coolify" Docker network to reach personal-api
PERSONAL_API_URL=http://personal-api:8000
# Default voice — verify available voices against GET /v1/voices on Pocket TTS
TTS_DEFAULT_VOICE=alba
# Pocket TTS model id — sent on every /v1/speak call. Personal-api servers
# default to a Spanish model; english-forge pins the English one. Unknown
# ids are ignored by Pocket TTS (hot-swap safe, backward compatible).
TTS_MODEL=english_2026-04_24l
TTS_JOB_POLL_INTERVAL_MS=500
TTS_JOB_TIMEOUT_SECONDS=30

# === STT (optional) ===
# Modes: web_speech (default), whisper_wasm, whisper_server, personal_api
STT_MODE=web_speech
# Model for whisper_server mode (tiny, base, small, medium, large)
WHISPER_MODEL=small
# Language hint sent on every personal-api /v1/transcribe call. "en" unlocks
# real Moonshine word timestamps (used by the pronunciation fluency metrics).
STT_LANGUAGE=en
# The assessment transcribes recordings via personal-api (Moonshine) with an
# automatic faster-whisper in-process fallback (same WHISPER_MODEL).
# macOS local dev only: point phonemizer at the homebrew espeak-ng library —
# in Docker (Debian) espeak-ng is installed via apt and needs no env var.
# PHONEMIZER_ESPEAK_LIBRARY=/opt/homebrew/opt/espeak-ng/lib/libespeak-ng.1.dylib

# === MEDIA ===
# TTS audio is written here as files (inside the data volume in Docker).
# Back it up together with the database: the DB only stores file references.
MEDIA_DIR=data/media

# === DATA LIFECYCLE ===
# An in-progress assessment with no activity for this many days is abandoned
# automatically, so the "one in-progress assessment" invariant never locks a
# user out of starting a new attempt.
ASSESSMENT_INACTIVE_DAYS=7
# Billable minutes per session are capped (an idle tab left open overnight must
# not count as practice). Time after the last message (plus grace) is not billed.
MAX_SESSION_MINUTES=180
SESSION_END_GRACE_MINUTES=2

# === CORS ===
CORS_ORIGINS=http://localhost:3590,http://127.0.0.1:3590
